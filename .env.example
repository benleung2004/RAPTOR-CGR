# Copy to .env and fill in. Any OpenAI-compatible endpoint works (DeepSeek, OpenRouter, Groq, Gemini...).

# Model that answers questions and writes RAPTOR summaries
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Optional: a different model as the judge (recommended, avoids self-preference bias).
# Leave empty to use the answering model.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# ── Web tutor (python web/server.py) ─────────────────────────────────────────
# Any OpenAI-compatible endpoint. Groq, OpenAI and Google Gemini block Hong Kong IPs,
# so from Hong Kong use DeepSeek (very cheap, about US$0.0005 per answer) as the primary.
CHAT_PRIMARY_API_KEY=
CHAT_PRIMARY_BASE_URL=https://api.deepseek.com
CHAT_PRIMARY_MODEL=deepseek-flash

# Optional fallback, used when the primary fails (e.g. an OpenRouter ":free" model,
# pick one at https://openrouter.ai/models?q=free and test it from your network first).
CHAT_FALLBACK_API_KEY=
CHAT_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
CHAT_FALLBACK_MODEL=

# Only for reasoning models that accept it (e.g. gpt-oss on Groq): low | medium | high
CHAT_PRIMARY_REASONING_EFFORT=
CHAT_FALLBACK_REASONING_EFFORT=

# Per-visitor limits
CHAT_RATE_PER_MINUTE=6
CHAT_RATE_PER_DAY=150
