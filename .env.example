# Copy to .env and fill in. Any OpenAI-compatible endpoint works (DeepSeek, OpenRouter, Groq, Gemini...).

# Model that answers questions and writes RAPTOR summaries
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Optional: a different model as the judge (recommended, avoids self-preference bias).
# Leave empty to use the answering model.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# ── Web tutor (python web/server.py) ─────────────────────────────────────────
# Primary: Groq free tier (fast). Get a key at https://console.groq.com/keys
CHAT_PRIMARY_API_KEY=
CHAT_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
CHAT_PRIMARY_MODEL=openai/gpt-oss-120b
CHAT_PRIMARY_REASONING_EFFORT=low
# Fallback when the primary is rate-limited or down (e.g. DeepSeek, very cheap). Optional.
CHAT_FALLBACK_API_KEY=
CHAT_FALLBACK_BASE_URL=https://api.deepseek.com
CHAT_FALLBACK_MODEL=deepseek-flash
# Per-visitor limits
CHAT_RATE_PER_MINUTE=6
CHAT_RATE_PER_DAY=150
